# ==============================================================================
# FarmRisk AI Backend Environment Variables
# ==============================================================================

# LLM Keys
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Supabase Vector DB (Optional for mock/dev, required for RAG)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LLM Providers Configuration
LLM_PROVIDER=gemini
ENABLE_GROQ_FALLBACK=true
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.2

# Cache Settings (in_memory or redis)
CACHE_TYPE=in_memory
# REDIS_URL=redis://redis:6379/0
ADVISORY_CACHE_TTL=43200

# App & Logging Settings
APP_ENV=development
DEBUG=true
LOG_FORMAT=TEXT
LOG_LEVEL=INFO
RAG_TOP_K=5
EMBEDDING_MODEL=intfloat/multilingual-e5-small
